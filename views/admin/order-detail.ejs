<div class="container-fluid p-4">
  <div class="row">
    <div class="col-md-6">
      <h5>Order Information</h5>
      <table class="table">
        <tr>
          <th>Order ID:</th>
          <td>#<%= order.id %></td>
        </tr>
        <tr>
          <th>Order Date:</th>
          <td><%= moment(order.createdAt).format('MMMM D, YYYY h:mm A') %></td>
        </tr>
        <tr>
          <th>Status:</th>
          <td>
            <span
              class="badge bg-<%= order.status === 'delivered' ? 'success' : order.status === 'cancelled' ? 'danger' : 'primary' %>"
            >
              <%= order.status.toUpperCase() %>
            </span>
          </td>
        </tr>
        <tr>
          <th>Total Amount:</th>
          <td>$<%= parseFloat(order.totalAmount).toFixed(2) %></td>
        </tr>
      </table>
    </div>
    <div class="col-md-6">
      <h5>Customer Information</h5>
      <table class="table">
        <tr>
          <th>Name:</th>
          <td><%= order.fullName %></td>
        </tr>
        <tr>
          <th>Email:</th>
          <td><%= order.email %></td>
        </tr>
        <tr>
          <th>Phone:</th>
          <td><%= order.phone %></td>
        </tr>
        <tr>
          <th>Address:</th>
          <td>
            <%= order.address %>, <%= order.ward %>, <%= order.district %>, <%=
            order.city %>
          </td>
        </tr>
      </table>
    </div>
  </div>

  <div class="row mt-4">
    <div class="col-12">
      <h5>Order Items</h5>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Price</th>
              <th>Quantity</th>
              <th class="text-end">Total</th>
            </tr>
          </thead>
          <tbody>
            <% order.items.forEach(function(item) { %>
            <tr>
              <td>
                <div class="d-flex align-items-center">
                  <img
                    src="<%= item.product.image || '/images/default-product.jpg' %>"
                    alt="<%= item.product.name %>"
                    class="me-2"
                    style="width: 50px; height: 50px; object-fit: cover"
                  />
                  <span><%= item.product.name %></span>
                </div>
              </td>
              <td>$<%= parseFloat(item.price).toFixed(2) %></td>
              <td><%= item.quantity %></td>
              <td class="text-end">
                $<%= (parseFloat(item.price) * item.quantity).toFixed(2) %>
              </td>
            </tr>
            <% }); %>
          </tbody>
          <tfoot>
            <tr>
              <td colspan="3" class="text-end"><strong>Subtotal</strong></td>
              <td class="text-end">
                $<%= parseFloat(order.totalAmount).toFixed(2) %>
              </td>
            </tr>
            <tr>
              <td colspan="3" class="text-end"><strong>Shipping</strong></td>
              <td class="text-end">Free</td>
            </tr>
            <tr>
              <td colspan="3" class="text-end"><strong>Total</strong></td>
              <td class="text-end">
                <strong
                  >$<%= parseFloat(order.totalAmount).toFixed(2) %></strong
                >
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>

  <% if (order.note) { %>
  <div class="row mt-4">
    <div class="col-12">
      <h5>Order Note</h5>
      <p class="mb-0"><%= order.note %></p>
    </div>
  </div>
  <% } %>
</div>
